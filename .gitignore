# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/frontend/.next/
/frontend/out/
/out/

# production
/build
/backend/dist
/backend/uploads
/public/uploads
/frontend/public/uploads
__pycache__/
*.pyc

# misc
.DS_Store
*.pem

# scripts & batch files
scripts/
backend/scripts/
*.bat

# images
*.jpg

# docs
docs/
markdown/
outputs/

# claude
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!*/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal markdown docs
*.md
!README.md
!Tài liệu dev.md

# log files
*.log
*.log.*
