{
  "name": "@ipark/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:reinit": "node scripts/reinit-and-seed.mjs",
    "db:clean": "mongosh \"$MONGODB_URI\" --quiet < src/scripts/clean_schema.js",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.11",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "roboto-font": "^0.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
