# Backend server
PORT=4000
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/bai-do-xe?retryWrites=true&w=majority&ssl=true&authSource=admin
MONGODB_DB=bai-do-xe

# Auth
JWT_SECRET=change-me-in-production

# AI service
AI_SERVICE_URL=http://127.0.0.1:5000

# Camera/RFID bridge (Python Flask service) - port 5050 by default
CAMERA_SERVICE_URL=http://127.0.0.1:5050

# Service token for Python bridge (smart_parking_rut_gon)
# Must match BRIDGE_SERVICE_TOKEN in Python .env / config
SERVICE_TOKEN=change-me-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# SMTP for OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=iPARK <your-email@gmail.com>
TOTP_ISSUER=iPARK

# RTSP camera defaults
RTSP_ENTRY_URL=rtsp://example.local/entry
RTSP_ENTRY_USERNAME=
RTSP_ENTRY_PASSWORD=
RTSP_EXIT_URL=rtsp://example.local/exit
RTSP_EXIT_USERNAME=
RTSP_EXIT_PASSWORD=

# PayOS credentials
PAYTOS_USE=true
PAYTOS_CHECKSUM_KEY=your-payos-checksum-key
PAYTOS_CLIENT_ID=your-payos-client-id
PAYTOS_API_KEY=your-payos-api-key
PAYOS_WEBHOOK_URL=http://localhost:4000/api/payos/webhook

# Optional pricing seed overrides
# PRICING_FREE_MINUTES=20
# PRICING_HOURLY_RATE=10000
# PRICING_OVERNIGHT_RATE=80000
# PRICING_MONTHLY_RATE=1200000
# PRICING_OVERDUE_FINE_RATE=20000

# Optional seed account overrides
# ADMIN_NAME=Super Admin iPARK
# ADMIN_EMAIL=admin@ipark.vn
# ADMIN_PASSWORD=admin
# STAFF_1_NAME=Nhan vien cong 1
# STAFF_1_EMAIL=nv.1@ipark.vn
# STAFF_1_PASSWORD=123456
# STAFF_2_NAME=Nhan vien cong 2
# STAFF_2_EMAIL=nv.2@ipark.vn
# STAFF_2_PASSWORD=123456
# STAFF_3_NAME=Nhan vien cong 3
# STAFF_3_EMAIL=nv.3@ipark.vn
# STAFF_3_PASSWORD=123456
