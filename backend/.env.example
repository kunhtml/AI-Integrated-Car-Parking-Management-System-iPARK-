# Backend server
PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS in production.
CORS_ORIGINS=https://app.example.com

# MongoDB
# Local (mac dinh khi dev tren may moi — can MongoDB dang chay o 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/bai-do-xe
MONGODB_DB=bai-do-xe
# Atlas / remote (bo comment va dien that — KHONG de chuoi <username> <password> <host>):
# Neu password co ky tu dac biet (@ : / # ?) phai URL-encode.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bai-do-xe?retryWrites=true&w=majority
# MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017/bai-do-xe?ssl=true&authSource=admin&replicaSet=atlas-xxxxx-shard-0

# Auth
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>

# AI service
AI_SERVICE_URL=http://127.0.0.1:5000

# Camera/RFID bridge (Python Flask service) - port 5050 by default
CAMERA_SERVICE_URL=http://127.0.0.1:5050

# Service token for Python bridge (smart_parking_rut_gon)
# Must match BRIDGE_SERVICE_TOKEN in Python .env / config
SERVICE_TOKEN=<generate-a-random-service-token-at-least-32-characters>

# Google OAuth
GOOGLE_CLIENT_ID=621428480613-k5gi2dn7sc2nrfbmjf52l9vbm8fmvdm0.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# SMTP for OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-app-password>
SMTP_FROM=iPARK <no-reply@example.com>
TOTP_ISSUER=iPARK

# RTSP camera defaults
RTSP_ENTRY_URL=rtsp://example.local/entry
RTSP_ENTRY_USERNAME=
RTSP_ENTRY_PASSWORD=
RTSP_EXIT_URL=rtsp://example.local/exit
RTSP_EXIT_USERNAME=
RTSP_EXIT_PASSWORD=

# PayOS credentials
PAYTOS_USE=true
PAYTOS_CHECKSUM_KEY=<payos-checksum-key>
PAYTOS_CLIENT_ID=<payos-client-id>
PAYTOS_API_KEY=<payos-api-key>
PAYOS_WEBHOOK_URL=http://localhost:4000/api/payos/webhook

# Optional pricing seed overrides
# PRICING_FREE_MINUTES=20
# PRICING_HOURLY_RATE=10000
# PRICING_OVERNIGHT_RATE=80000
# PRICING_MONTHLY_RATE=1200000
# PRICING_OVERDUE_FINE_RATE=20000

# Optional seed account overrides
# ADMIN_NAME=Super Admin iPARK
# ADMIN_EMAIL=admin@ipark.vn
# ADMIN_PASSWORD=admin
# STAFF_1_NAME=Nhan vien cong 1
# STAFF_1_EMAIL=nv.1@ipark.vn
# STAFF_1_PASSWORD=123456
# STAFF_2_NAME=Nhan vien cong 2
# STAFF_2_EMAIL=nv.2@ipark.vn
# STAFF_2_PASSWORD=123456
# STAFF_3_NAME=Nhan vien cong 3
# STAFF_3_EMAIL=nv.3@ipark.vn
# STAFF_3_PASSWORD=123456
