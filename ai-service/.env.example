# Backend Node.js
BACKEND_URL=http://localhost:4000
# Token xác thực service-to-service (MỘT nguồn duy nhất ở ai-service/config.py).
# Trên dev có thể bỏ trống — dùng default khớp backend
# (smart-parking-rut-gon-service-token-change-me).
# Ngoài dev (APP_ENV != development): BẮT BUỘC đặt token mạnh >= 32 ký tự,
# nếu không service sẽ từ chối khởi động.
BRIDGE_SERVICE_TOKEN=
# development | production — đặt khác "development" để bật fail-fast cho token
APP_ENV=development

# CORS: origin của frontend được phép gọi bridge (mặc định http://localhost:3000,
# khớp FRONTEND_URL của backend)
FRONTEND_ORIGIN=http://localhost:3000

# Host Flask bind. Mặc định 127.0.0.1 (chỉ máy này).
# Đặt 0.0.0.0 nếu cần cho máy khác trong LAN truy cập.
APP_HOST=127.0.0.1

# Serial
SERIAL_PORT_IN=COM3
SERIAL_PORT_OUT=COM5

# Camera — ưu tiên chọn theo TÊN DirectShow (tránh dính webcam laptop).
# Index OpenCV KHÔNG khớp Device Manager / pygrabber comment.
CAMERA_NAME_IN=USB2.0 PC CAMERA
CAMERA_NAME_ORDINAL_IN=0
CAMERA_NAME_OUT=USB2.0 PC CAMERA
CAMERA_NAME_ORDINAL_OUT=1
CAMERA_EXCLUDE=ACER,User Facing
# Fallback nếu không có tên
CAMERA_INDEX_IN=0
CAMERA_INDEX_OUT=1
# CAMERA_BACKEND=DSHOW

# Flask local UI
FLASK_PORT=5050

# ===== FastAPI (main.py) =====
# Giới hạn kích thước body upload (bytes). Mặc định 10MB.
MAX_UPLOAD_BYTES=10485760
# rtspUrl: cho phép thêm scheme http/https ngoài rtsp (mặc định chỉ rtsp)
CAMERA_HTTP_ALLOWED=0
# Whitelist host camera cho rtspUrl, phân tách bởi dấu phẩy.
# Hỗ trợ wildcard hậu tố, ví dụ: 192.168.1.10,*.mystream.com
# Bỏ trống = chặn MỌI host (an toàn nhất — hãy đặt whitelist thật).
CAMERA_HOST_WHITELIST=

# ===== OCR / AI =====
OCR_ENABLED=true
# yolo | opencv | fullframe  (opencv = nhẹ, không load Torch)
YOLO_MODEL_PATH=E:/AI-Integrated-Car-Parking-Management-System-iPARK-/ai-service/yolo_model/best.pt
PLATE_DETECTOR=opencv
# legacy | single-worker (khuyến nghị single-worker để tránh OOM 2 cam)
OCR_SCHEDULER_MODE=single-worker
OCR_INTERVAL_SEC=2.0
OCR_MAX_WIDTH=480
YOLO_MAX_WIDTH=640
YOLO_IMGSZ=640
YOLO_CONF_THR=0.25
OPENCV_PLATE_MAX_CANDIDATES=5
PLATE_COOLDOWN_SEC=5.0
PLATE_CONFIRM_COUNT=1

# Snapshot: true = chỉ ghi khi biển số hợp lệ
SNAPSHOT_ON_VALID_PLATE_ONLY=true

# Soft-limit RSS (MB). 0 = tắt. Vượt ngưỡng → tạm dừng OCR (stream/RFID vẫn chạy)
AI_MEMORY_SOFT_LIMIT_MB=0
AI_MEMORY_COOLDOWN_SEC=30
AI_METRIC_INTERVAL_SEC=60

# Background HTTP/lookup/auto-close pool
BACKGROUND_WORKER_COUNT=2
BACKGROUND_QUEUE_SIZE=32

# Stream / CPU
MJPEG_FPS=12
JPEG_QUALITY=65
STREAM_MAX_WIDTH=480
CAMERA_LOOP_SLEEP=0.03
LIVE_PREVIEW_INTERVAL_SEC=1.0
TORCH_NUM_THREADS=2
CV_NUM_THREADS=2
