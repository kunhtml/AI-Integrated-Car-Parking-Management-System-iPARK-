# Backend Node.js
BACKEND_URL=http://localhost:4000
BRIDGE_SERVICE_TOKEN=<same-random-service-token-as-backend-service-token>

# Serial
SERIAL_PORT_IN=COM3
SERIAL_PORT_OUT=COM5

# Camera — ưu tiên chọn theo TÊN DirectShow (tránh dính webcam laptop).
# Index OpenCV KHÔNG khớp Device Manager / pygrabber comment.
CAMERA_NAME_IN=USB2.0 PC CAMERA
CAMERA_NAME_ORDINAL_IN=0
CAMERA_NAME_OUT=USB2.0 PC CAMERA
CAMERA_NAME_ORDINAL_OUT=1
CAMERA_EXCLUDE=ACER,User Facing
# Fallback nếu không có tên
CAMERA_INDEX_IN=0
CAMERA_INDEX_OUT=1
# CAMERA_BACKEND=DSHOW

# Flask local UI
FLASK_PORT=5050

# ===== OCR / AI =====
OCR_ENABLED=true
# yolo | opencv | fullframe  (opencv = nhẹ, không load Torch)
PLATE_DETECTOR=opencv
# legacy | single-worker (khuyến nghị single-worker để tránh OOM 2 cam)
OCR_SCHEDULER_MODE=single-worker
OCR_INTERVAL_SEC=2.0
OCR_MAX_WIDTH=480
YOLO_MAX_WIDTH=640
YOLO_IMGSZ=640
YOLO_CONF_THR=0.25
OPENCV_PLATE_MAX_CANDIDATES=5
PLATE_COOLDOWN_SEC=5.0
PLATE_CONFIRM_COUNT=1

# Snapshot: true = chỉ ghi khi biển số hợp lệ
SNAPSHOT_ON_VALID_PLATE_ONLY=true

# Soft-limit RSS (MB). 0 = tắt. Vượt ngưỡng → tạm dừng OCR (stream/RFID vẫn chạy)
AI_MEMORY_SOFT_LIMIT_MB=0
AI_MEMORY_COOLDOWN_SEC=30
AI_METRIC_INTERVAL_SEC=60

# Background HTTP/lookup/auto-close pool
BACKGROUND_WORKER_COUNT=2
BACKGROUND_QUEUE_SIZE=32

# Stream / CPU
MJPEG_FPS=12
JPEG_QUALITY=65
STREAM_MAX_WIDTH=480
CAMERA_LOOP_SLEEP=0.03
LIVE_PREVIEW_INTERVAL_SEC=1.0
TORCH_NUM_THREADS=2
CV_NUM_THREADS=2
